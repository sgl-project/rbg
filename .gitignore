# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
Dockerfile.cross

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Go build binary
main

# Locally generated E2E build and report artifacts
_artifacts/
test/e2e/**/artifacts/

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
.vscode
.qoder
# Shared skills live in .agents/skills/; .claude/ holds only personal content (memory, settings, etc.)
.claude/

*.swp
*.swo
*~
.devcontainer
**/*.tgz
**/.DS_Store


# python
__pycache__/
*.py[cod]
*$py.class

# Local scratch: build binaries, logs, reports
tmp/
